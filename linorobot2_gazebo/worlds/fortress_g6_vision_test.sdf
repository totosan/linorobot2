<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="fortress_g6_vision_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu" />

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Person target for the isolated G6 camera fixture: human.dae (T-pose,
      ~1.65 m, untextured), turned to face the robot. At x=4 m the complete
      silhouette fits the forward Fortress camera view. It is a test target,
      not a photorealistic human or a detector guarantee. The simplified
      torso/leg box gives the planar LiDAR the same object; the T-pose arms are
      above the LiDAR plane and have no collision.
    -->
    <model name="g6_person_proxy">
      <static>true</static>
      <pose>4.0 0 0 0 0 0</pose>
      <link name="body">
        <visual name="human_mesh">
          <pose>0 0 0 0 0 -1.5708</pose>
          <geometry>
            <mesh><uri>human.dae</uri></mesh>
          </geometry>
        </visual>
        <collision name="torso_collision">
          <pose>0 0 0.825 0 0 0</pose>
          <geometry><box><size>0.3 0.45 1.65</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
