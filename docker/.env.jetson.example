# Copy to .env.jetson on the Jetson; values below match the inspected host/image.
JETSON_ROS_IMAGE=l4t-ros2:humble-v2.4
JETSON_WORKSPACE=/home/jetson/linorobot2_ws
JETSON_ESP32_DEVICE=/dev/ttyESP32
JETSON_LIDAR_DEVICE=/dev/rplidar
ROS_DOMAIN_ID=44
MICRO_ROS_TRANSPORT=serial
MICRO_ROS_BAUDRATE=921600
